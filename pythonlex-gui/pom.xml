<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pythonlex</groupId>
    <artifactId>pythonlex-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>pythonlex-gui</artifactId>
  <name>pythonlex-gui</name>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.pythonlex</groupId>
      <artifactId>pythonlex-core</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.pythonlex</groupId>
      <artifactId>pythonlex-lexer</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Ejecutar GUI:
           mvn -q -pl pythonlex-gui exec:java
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <mainClass>com.pythonlex.gui.GuiMain</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
